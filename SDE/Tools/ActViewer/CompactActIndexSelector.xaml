<UserControl x:Class="SDE.Tools.ActViewer.CompactActIndexSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Opacity="0.7" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary" FontSize="10"
			 xmlns:local="clr-namespace:SDE.Tools.ActViewer" xmlns:actselectorcomponents="clr-namespace:GrfToWpfBridge.ActRenderer.ActSelectorComponents;assembly=GrfToWpfBridge" mc:Ignorable="d"
             Background="{StaticResource TabItemBackground}" Foreground="{StaticResource TextForeground}">
    <Grid Background="{StaticResource TabItemBackground}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
		<actselectorcomponents:ActionDirectionalControl x:Name="_directionalControl" VerticalAlignment="Bottom" />

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.RowSpan="2" VerticalAlignment="Bottom">
				<Styles:FancyButton x:Name="_buttonRenderMode" VerticalAlignment="Top" Tag="3" Click="_buttonRenderMode_Click" Height="16" Width="16" Grid.Row="0" Grid.Column="0" ImagePath="editor.png">
					<Styles:FancyButton.ToolTip>
						Render mode is currently set to "Editor".
					</Styles:FancyButton.ToolTip>
				</Styles:FancyButton>
				<Styles:FancyButton x:Name="_buttonSettings" ImagePath="settings.png" VerticalAlignment="Top" Tag="3" Click="_buttonSettings_Click" Height="16" Width="16" Grid.Row="0" Grid.Column="0" />
				<Styles:FancyButton x:Name="_buttonExport" ImagePath="forward.png" VerticalAlignment="Top" Tag="3" Click="_buttonExport_Click" Height="16" Width="16" Grid.Row="0" Grid.Column="0" />
			</StackPanel>

			<TextBlock ToolTipService.ShowDuration="1000000"  VerticalAlignment="Center" Text="Animation" TextAlignment="Center" Margin="3" TextWrapping="Wrap" Grid.Column="1" >
				<TextBlock.ToolTip>
					<TextBlock TextAlignment="Left">
                                        Animations are not part of the Act structure. This simply makes the
                                    <LineBreak />
                                        action index selection easier.
					</TextBlock>
				</TextBlock.ToolTip>
                            </TextBlock>
			<TextBlock Text="Action" Grid.Row="1" VerticalAlignment="Center" Margin="3" TextAlignment="Center" TextWrapping="Wrap" Grid.Column="1" />
		</Grid>
		<Grid Grid.Column="2" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ComboBox Grid.Row="0" FontSize="12" VerticalAlignment="Center" Name="_comboBoxAnimationIndex" Width="80" HorizontalAlignment="Left" Margin="1" />
            <ComboBox Grid.Row="1" FontSize="12" VerticalAlignment="Center" Name="_comboBoxActionIndex" Width="80" HorizontalAlignment="Left" Margin="1" />
        </Grid>
		<local:FrameScrollBar x:Name="_sbFrameIndex" Grid.ColumnSpan="2" Grid.Row="1" Margin="0 1 0 1" />
		<local:FrameTextBoxSelector Grid.Row="1" Grid.Column="2" x:Name="_frameTbSelect" />
	</Grid>
</UserControl>
