<UserControl x:Class="SDE.Tools.ActViewer.ReadonlyActIndexSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Opacity="0.7" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary" FontSize="10"
			 xmlns:local="clr-namespace:SDE.Tools.ActViewer" xmlns:actselectorcomponents="clr-namespace:GrfToWpfBridge.ActRenderer.ActSelectorComponents;assembly=GrfToWpfBridge" mc:Ignorable="d"
             Background="{StaticResource TabItemBackground}" Foreground="{StaticResource TextForeground}">
    <Grid Background="{StaticResource TabItemBackground}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
		<actselectorcomponents:ActionDirectionalControl x:Name="_directionalControl" VerticalAlignment="Bottom" />
        <Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
		</Grid>
		<Grid Grid.Column="2" HorizontalAlignment="Left">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<ComboBox Grid.Row="0" FontSize="12" VerticalAlignment="Center" Name="_comboBoxAnimationIndex" Width="80" HorizontalAlignment="Left" Margin="1" Visibility="Collapsed" />
			<ComboBox Grid.Row="1" FontSize="12" VerticalAlignment="Center" Name="_comboBoxActionIndex" Width="80" HorizontalAlignment="Left" Margin="1" Visibility="Collapsed" />
		</Grid>
	</Grid>
</UserControl>
