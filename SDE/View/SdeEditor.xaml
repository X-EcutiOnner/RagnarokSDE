<Styles:TkWindow
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
        xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
        xmlns:MultiGrf="clr-namespace:GrfToWpfBridge.MultiGrf;assembly=GrfToWpfBridge"
        xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
        xmlns:Application="clr-namespace:GrfToWpfBridge.Application;assembly=GrfToWpfBridge"
        xmlns:view="clr-namespace:SDE.View"
        xmlns:controls="clr-namespace:SDE.View.Controls" xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ErrorConsole="clr-namespace:SDE.Editor.ErrorConsole" mc:Ignorable="av" x:Class="SDE.View.SdeEditor"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Height="600" Width="941" Background="{DynamicResource TabItemBackground}">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Menu Height="30">
			<MenuItem>
				<MenuItem.Header>
					<Label Content="File" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5 0 -5 0" />
				</MenuItem.Header>
				<MenuItem x:Name="_menuItemNewProject" TokeiLibrary:WpfProperties.ImagePath="add.png" Click="_menuItemNewProject_Click"  Header="New project" />
				<MenuItem x:Name="_menuItemProjectLoadAs" TokeiLibrary:WpfProperties.ImagePath="newFile.png" Click="_menuItemProjectLoadAs_Click" Header="Load project..." />
				<MenuItem x:Name="_menuItemProjectSaveAs" TokeiLibrary:WpfProperties.ImagePath="empty.png" Click="_menuItemProjectSaveAs_Click" Header="Save project info..." />
				<MenuItem x:Name="_menuItemDatabaseSave" TokeiLibrary:WpfProperties.ImagePath="save.png" Click="_menuItemDatabaseSave_Click" Header="Save database (quick)" InputGestureText="Ctrl-S" />
				<Separator />
				<!--
				<MenuItem Header="Export to db"  TokeiLibrary:WpfProperties.ImagePath="export.png" >
					<MenuItem x:Name="_menuItemExportDbCurrent"  TokeiLibrary:WpfProperties.ImagePath="export.png" Click="_menuItemExportDbCurrent_Click" Header="Current" IsEnabled="False" />
					<MenuItem Header="rAthena">
						<MenuItem x:Name="_menuItemExportRaRenewal" Click="_menuItemExportRaRenewal_Click" Header="Export project - Renewal" />
						<MenuItem x:Name="_menuItemExportRaPreRenewal" Click="_menuItemExportRaPreRenewal_Click" Header="Export project - Pre-Renewal" />
					</MenuItem>
					<MenuItem Header="Hercules">
						<MenuItem x:Name="_menuItemExportHercRenewal" Click="_menuItemExportHercRenewal_Click" Header="Export project - Renewal" />
						<MenuItem x:Name="_menuItemExportHercPreRenewal" Click="_menuItemExportHercPreRenewal_Click" Header="Export project - Pre-Renewal" />
					</MenuItem>
				</MenuItem>
				<MenuItem Header="Export to SQL" TokeiLibrary:WpfProperties.ImagePath="dbBlack.png" IsEnabled="True" >
					<MenuItem x:Name="_menuItemExportSqlCurrent" TokeiLibrary:WpfProperties.ImagePath="export.png" Click="_menuItemExportSqlCurrent_Click" Header="Current" IsEnabled="False" />
					<MenuItem Header="rAthena">
						<MenuItem x:Name="_menuItemExportSqlRaRenewal" Click="_menuItemExportSqlRaRenewal_Click" Header="Export project - Renewal" />
						<MenuItem x:Name="_menuItemExportSqlRaPreRenewal" Click="_menuItemExportSqlRaPreRenewal_Click" Header="Export project - Pre-Renewal" />
					</MenuItem>
					<MenuItem Header="Hercules">
						<MenuItem x:Name="_menuItemExportSqlHercRenewal" Click="_menuItemExportSqlHercRenewal_Click" Header="Export project - Renewal" />
						<MenuItem x:Name="_menuItemExportSqlHercPreRenewal" Click="_menuItemExportSqlHercPreRenewal_Click" Header="Export project - Pre-Renewal" />
					</MenuItem>
				</MenuItem>
				<Separator />
				-->
				<Styles:TkMenuItem Header="Convert client dbs" IconPath="convert.png" >
					<Styles:TkMenuItem x:Name="_menuItemConvertClientDbToTxt" IconPath="txt.png" Header="Export to txt files" Click="_menuItemConvertClientDbToTxt_Click" IsEnabled="True" />
					<Styles:TkMenuItem x:Name="_menuItemConvertClientDbToLua" IconPath="lua.png" Header="Export to lua files" Click="_menuItemConvertClientDbToLua_Click" IsEnabled="True" />
				</Styles:TkMenuItem>
				<Separator />
				<MenuItem x:Name="_menuItemRecentProjects" IsEnabled="False" Header="Recent projects"/>
				<Separator />
				<MenuItem x:Name="_menuItemAbout" TokeiLibrary:WpfProperties.ImagePath="help.png" Header="About..." Click="_menuItemAbout_Click" />
				<MenuItem x:Name="_menuItemClose" Header="Close" Click="_menuItemClose_Click" />
			</MenuItem>
			<MenuItem>
				<MenuItem.Header>
					<Label Content="Edit" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5 0 -5 0" />
				</MenuItem.Header>
				<Styles:TkMenuItem x:Name="_menuItemReload" TokeiLibrary:WpfProperties.ImagePath="refresh.png" Header="Reload database" Click="_menuItemReloadDatabase_Click" />
				<Styles:TkMenuItem x:Name="_menuItemReplaceAll" TokeiLibrary:WpfProperties.ImagePath="convert.png" Header="Replace all..." Click="_menuItemReplaceAll_Click" />
				<Styles:TkMenuItem x:Name="_menuItemCopyAll" TokeiLibrary:WpfProperties.ImagePath="imconvert.png" Header="Copy all..." Click="_menuItemCopyAll_Click" />
				<Separator />
				<Styles:TkMenuItem Header="Undo" TokeiLibrary:WpfProperties.ImagePath="undo.png" IsEnabled="{Binding IsEnabled, ElementName=_tmbUndo}" Click="_tbmUndo_Click" ShortcutCmd="Application.UndoGlobal" />
				<Styles:TkMenuItem Header="Redo" TokeiLibrary:WpfProperties.ImagePath="redo.png" IsEnabled="{Binding IsEnabled, ElementName=_tmbRedo}" Click="_tbmRedo_Click" ShortcutCmd="Application.RedoGlobal" />
				<Styles:TkMenuItem Header="Navigate backward" TokeiLibrary:WpfProperties.ImagePath="backward.png" IsEnabled="{Binding IsEnabled, ElementName=_tnbUndo}" Click="_tnbUndo_Click" ShortcutCmd="Application.NavigationBackward" />
				<Styles:TkMenuItem Header="Navigate forward" TokeiLibrary:WpfProperties.ImagePath="forward.png" IsEnabled="{Binding IsEnabled, ElementName=_tnbRedo}" Click="_tnbRedo_Click" ShortcutCmd="Application.NavigationForward" />
				<Separator />
				<Styles:TkMenuItem x:Name="_menuItemAddItem" TokeiLibrary:WpfProperties.ImagePath="add.png" Header="Add entry" Click="_menuItemAddItem_Click" />
				<Styles:TkMenuItem x:Name="_menuItemAddItemRage" TokeiLibrary:WpfProperties.ImagePath="add.png" Header="Add range..." Click="_menuItemAddItemRage_Click" />
				<Styles:TkMenuItem x:Name="_menuItemAddItemRaw" TokeiLibrary:WpfProperties.ImagePath="add.png" Header="Add entry from raw db line" Click="_menuItemAddItemRaw_Click" />
				<Styles:TkMenuItem x:Name="_menuItemChangeId" TokeiLibrary:WpfProperties.ImagePath="properties.png" Header="Change ID..." Click="_menuItemChangeId_Click" />
				<Styles:TkMenuItem x:Name="_menuItemCopyItemTo" TokeiLibrary:WpfProperties.ImagePath="imconvert.png" Header="Copy selected item to..." Click="_menuItemCopyItemTo_Click" />
				<Styles:TkMenuItem x:Name="_menuItemDeleteItem" TokeiLibrary:WpfProperties.ImagePath="delete.png" Header="Delete item" Click="_menuItemDeleteItem_Click" />
			</MenuItem>
			<MenuItem>
				<MenuItem.Header>
					<Label Content="Tables" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5 0 -5 0" />
				</MenuItem.Header>
				<MenuItem x:Name="_menuItemReplaceFromFile" TokeiLibrary:WpfProperties.ImagePath="imconvert.png" Header="Import fields from..." Click="_menuItemReplaceFromFile_Click" />
				<MenuItem x:Name="_menuItemImportFromFile" TokeiLibrary:WpfProperties.ImagePath="forward.png" Header="Import a db from file..." Click="_menuItemImportFromFile_Click" />
				<Separator />
				<MenuItem Header="Export">
					<MenuItem x:Name="_menuItemExportTradeRestrictions" Header="Generate trade restrictions..." TokeiLibrary:WpfProperties.ImagePath="export.png" Click="_menuItemExportTradeRestrictions_Click" />
				</MenuItem>
				<Separator />
				<MenuItem x:Name="_menuItemEditLuaSettings" TokeiLibrary:WpfProperties.ImagePath="settings.png" Header="Set lua tables' paths" Click="_menuItemEditLuaSettings_Click" />
				<MenuItem x:Name="_menuItemValidate" TokeiLibrary:WpfProperties.ImagePath="validity.png" Header="Validate table" Click="_menuItemValidate_Click" />
			</MenuItem>
			<MenuItem>
				<MenuItem.Header>
					<Label Content="Tools" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5 0 -5 0" />
				</MenuItem.Header>
				<MenuItem x:Name="_menuItemScript" TokeiLibrary:WpfProperties.ImagePath="dos.png" Header="IronPython Script..." Click="_menuItemScript_Click" />
				<Separator />
				<MenuItem x:Name="_menuItemBackups" TokeiLibrary:WpfProperties.ImagePath="archive.png" Header="Backups manager" Click="_menuItemBackups_Click" />
				<Separator />
				<MenuItem x:Name="_menuItemMapCache" TokeiLibrary:WpfProperties.ImagePath="cache.png" Header="Mapcache editor" Click="_menuItemMapCache_Click" />
				<MenuItem x:Name="_menuItemMobStats" TokeiLibrary:WpfProperties.ImagePath="properties.png" Header="Mob stats adjust" Click="_menuItemMobStats_Click" />
				<MenuItem x:Name="_menuItemShopSimulator" TokeiLibrary:WpfProperties.ImagePath="editor.png" Header="Shop simulator" Click="_menuItemShopSimulator_Click" />
				<MenuItem x:Name="_menuItemConvertItemIds" TokeiLibrary:WpfProperties.ImagePath="convert.png" Header="Convert item IDs from text" Click="_menuItemConvertItemIds_Click" />
				<MenuItem x:Name="_menuItemDebugTables" TokeiLibrary:WpfProperties.ImagePath="warning16.png" Header="Debug tables" Click="_menuItemDebugTables_Click" />
				<MenuItem Header="Client item image export...">
					<MenuItem x:Name="_menuItemInventoryExport" Header="Export inventory images..." Click="_menuItemInventoryExport_Click" />
					<MenuItem x:Name="_menuItemIllustrationExport" Header="Export illustration images..." Click="_menuItemIllustrationExport_Click" />
				</MenuItem>
				<Separator />
				<MenuItem x:Name="_menuItemSettings" TokeiLibrary:WpfProperties.ImagePath="settings.png" Header="Settings" Click="_menuItemSettings_Click" />
			</MenuItem>
		</Menu>
		<DockPanel Margin="170 0 0 0" HorizontalAlignment="Left">
			<controls:ToggleMemoryButton x:Name="_tmbUndo" PrimaryButtonImagePath="undo.png" DisplayFormat="Undo {0} action" />
			<controls:ToggleMemoryButton x:Name="_tmbRedo" PrimaryButtonImagePath="redo.png" DisplayFormat="Redo {0} action" />
			<controls:ToggleMemoryButton Margin="10 0 0 0" x:Name="_tnbUndo" PrimaryButtonImagePath="backward.png" DisplayFormat="Go back {0} element" />
			<controls:ToggleMemoryButton x:Name="_tnbRedo" PrimaryButtonImagePath="forward.png" DisplayFormat="Go forward {0} element" />
		</DockPanel>
		<Styles:TkProgressBar x:Name="_progressBar" Width="300" HorizontalAlignment="Right" Margin="0 0 3 0"  />
		<Border Background="{DynamicResource TabControlBackground}" Grid.Row="1" SnapsToDevicePixels="True">
			<Grid>
				<TabControl SnapsToDevicePixels="True" x:Name="_mainTabControl" SelectionChanged="_mainTabControl_SelectionChanged" Style="{DynamicResource TabControlStyled}">
					<TabItem Style="{DynamicResource DatabaseTabStyle}">
						<TabItem.Header>
							<controls:DisplayLabel FontWeight="Bold" DisplayText="Settings" Foreground="{DynamicResource TextForeground}"/>
						</TabItem.Header>
						<Grid SnapsToDevicePixels="True">
							<Grid.RowDefinitions>
								<RowDefinition Height="auto" />
								<RowDefinition Height="auto" />
								<RowDefinition Height="auto" />
								<RowDefinition Height="auto" />
								<RowDefinition />
							</Grid.RowDefinitions>
							<StackPanel>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="auto" />
										<ColumnDefinition Width="auto" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="auto" />
										<RowDefinition Height="auto" />
									</Grid.RowDefinitions>
									<Label Content="Client encoding" Padding="0" Margin="3" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}">
										<Label.ToolTip>
											<TextBlock><Run Text="Encoding used for the client databases and lua files."/></TextBlock>
										</Label.ToolTip>
									</Label>
									<Application:EncodingPicker Grid.Column="1" Margin="3" x:Name="_comboBoxEncoding" IsReadOnly="True" Width="120" HorizontalAlignment="Left" />
									<Label Content="Server encoding" Padding="0" Grid.Row="1" Margin="3" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}">
										<Label.ToolTip>
											<TextBlock><Run Text="Encoding used to read and write the server database files."/></TextBlock>
										</Label.ToolTip>
									</Label>
									<Application:EncodingPicker Grid.Column="1" Grid.Row="1" Margin="3" x:Name="_comboBoxEncodingServer" IsReadOnly="True" Width="120" HorizontalAlignment="Left" />
								</Grid>
								<TextBlock Margin="3" Text="Resource files or folders (drop a GRF or a data folder) : " Foreground="{DynamicResource TextForeground}" />
							</StackPanel>
							<MultiGrf:MetaGrfResourcesViewer Grid.Row="1" x:Name="_metaGrfViewer" Height="100" />
							<Grid x:Name="_gridTextFilesSettings" Grid.Row="2" >
								<Grid.ColumnDefinitions>
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
							</Grid>
							<StackPanel x:Name="_spPaths" Grid.Row="2"/>
							<Grid Grid.Row="4">
								<Grid.RowDefinitions>
									<RowDefinition Height="auto" />
									<RowDefinition Height="auto" />
									<RowDefinition />
								</Grid.RowDefinitions>
								<CheckBox Margin="3" x:Name="_cbClientDbSync" Content="Synchronize with client database files" HorizontalAlignment="Left" Foreground="{DynamicResource TextForeground}" />
								<DockPanel Grid.Row="1">
									<CheckBox Margin="3 3 15 3" x:Name="_cbUseLuaFiles" Content="Use lua files" HorizontalAlignment="Left" Foreground="{DynamicResource TextForeground}" />
									<Button HorizontalAlignment="Left" x:Name="_buttonLuaSettings" Click="_menuItemEditLuaSettings_Click" VerticalAlignment="Top" Height="22">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="auto" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>
											<Image Grid.Column="0" TokeiLibrary:WpfProperties.ImagePath="settings.png" />
											<Label Padding="0" Margin="3 0 3 0" VerticalAlignment="Center" Content="Edit lua settings" Grid.Column="1" Foreground="{DynamicResource TextForeground}" />
										</Grid>
									</Button>
								</DockPanel>
								<Grid x:Name="_gridTextFilesSettingsClient" Grid.Row="2">
									<Grid.RowDefinitions>
										<RowDefinition Height="auto" />
										<RowDefinition Height="auto" />
										<RowDefinition />
										<RowDefinition Height="20" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
										<ColumnDefinition Width="4" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Row="1" Text="Text files" Margin="3" Foreground="{DynamicResource TextForeground}" />
									<TextBlock Grid.Row="1" Grid.Column="3" Text="Lua files" Margin="3" Foreground="{DynamicResource TextForeground}" />
									<ListView SnapsToDevicePixels="True" x:Name="_listItemClientTxtFiles" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Grid.Column="0" Margin="3">
										<ListView.ItemContainerStyle>
											<Style TargetType="{x:Type ListViewItem}">
												<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
												<Setter Property="Padding" Value="0"/>
											</Style>
										</ListView.ItemContainerStyle>
									</ListView>
									<ListView SnapsToDevicePixels="True" IsEnabled="False" x:Name="_listItemClientLuaFiles" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Grid.Row="2" Grid.Column="2" Margin="3">
										<ListView.ItemContainerStyle>
											<Style TargetType="{x:Type ListViewItem}">
												<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
												<Setter Property="Padding" Value="0"/>
											</Style>
										</ListView.ItemContainerStyle>
									</ListView>
								</Grid>
							</Grid>
						</Grid>
					</TabItem>
					<TabItem Style="{DynamicResource DatabaseTabStyle}" Foreground="{DynamicResource TextForeground}" Name="_tiErrorConsole">
						<TabItem.Header>
							<controls:DisplayLabel FontWeight="Bold" DisplayText="Error console" />
						</TabItem.Header>
						<ErrorConsole:ErrorConsoleControl x:Name="_errorConsole" />
					</TabItem>
				</TabControl>
			</Grid>
		</Border>
	</Grid>
</Styles:TkWindow>
