<Styles:TkWindow x:Class="SDE.View.Editors.JobEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
        xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
        xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
		SnapsToDevicePixels="True" UseLayoutRounding="True"
        Width="650"
        Background="{DynamicResource TabItemBackground}" Foreground="{DynamicResource TextForeground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
				<DockPanel>
					<CheckBox Name="_cbSelectAll" Content="Select all" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </DockPanel>
                <CheckBox Name="_cbRestrictClasses" Content="Restrict to possible classes only" Margin="3" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
        <Grid Name="_jobGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition />
				<RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<StackPanel x:Name="_panel0" Margin="3" Grid.Row="0" Grid.Column="0">
				<TextBlock Text="1st Jobs" HorizontalAlignment="Center" Margin="3" />
			</StackPanel>
			<Border Grid.Column="0" Grid.Row="0" BorderThickness="2" BorderBrush="#AEB8FF" CornerRadius="3" Margin="2" />
			
			<StackPanel x:Name="_panel1" Margin="3" Grid.Row="0" Grid.Column="1">
				<TextBlock Text="2nd - 1 Jobs" HorizontalAlignment="Center" Margin="3" />
			</StackPanel>
			<Border Grid.Column="1" Grid.Row="0" BorderThickness="2" BorderBrush="#AEB8FF" CornerRadius="3" Margin="2" />

			<StackPanel x:Name="_panel2" Margin="3" Grid.Row="0" Grid.Column="2">
				<TextBlock Text="2nd - 1 Jobs" HorizontalAlignment="Center" Margin="3" />
			</StackPanel>
			<Border Grid.Column="2" Grid.Row="0" BorderThickness="2" BorderBrush="#AEB8FF" CornerRadius="3" Margin="2" />

			<StackPanel x:Name="_panel3" Margin="3" Grid.Row="1" Grid.Column="0">
				<TextBlock Text="Extended 1st Jobs" HorizontalAlignment="Center" Margin="3" />
			</StackPanel>
			<Border Grid.Column="0" Grid.Row="1" BorderThickness="2" BorderBrush="#AEB8FF" CornerRadius="3" Margin="2" />

			<StackPanel x:Name="_panel4" Margin="3" Grid.Row="1" Grid.Column="1">
				<TextBlock Text="Extended 2nd - 1 Jobs" HorizontalAlignment="Center" Margin="3" />
			</StackPanel>
			<Border Grid.Column="1" Grid.Row="1" BorderThickness="2" BorderBrush="#AEB8FF" CornerRadius="3" Margin="2" />

			<StackPanel x:Name="_panel5" Margin="3" Grid.Row="1" Grid.Column="2">
				<TextBlock Text="Extended 2nd - 2 Jobs" HorizontalAlignment="Center" Margin="3" />
			</StackPanel>
			<Border Grid.Column="2" Grid.Row="1" BorderThickness="2" BorderBrush="#AEB8FF" CornerRadius="3" Margin="2" />
			
            <TextBox IsReadOnly="True" Grid.Row="2" Height="40" Grid.ColumnSpan="4" Name="_previewClass" Margin="3" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="0" />
        </Grid>
        <Grid Name="_footerGrid" TokeiLibrary:WpfProperties.IsDraggable="True" Grid.Row="2" Height="49" Background="{DynamicResource UIDialogBackground}">
            <Grid Margin="0 0 3 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
				<DockPanel Grid.Column="2">
					<Button Name="_buttonOk" Click="_buttonOk_Click" Content="Ok" Height="25" Margin="3" MinWidth="100" Grid.Column="2" />
                    <Button Name="_buttonCancel" Click="_buttonCancel_Click" Content="Cancel" Height="25" Margin="3" MinWidth="100" Grid.Column="3" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Styles:TkWindow>
