<UserControl x:Class="SDE.View.Controls.TextViewItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary" Padding="0"
        xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
        xmlns:Controls="clr-namespace:SDE.View.Controls"
        SnapsToDevicePixels="true"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="50" >
    <UserControl.Resources>
		<Controls:WidthAdjusterConverter x:Key="WidthAdjusterConverter" />
    </UserControl.Resources>
	<Border BorderThickness="1" Name="_grid" Width="{Binding ElementName=_grid, Converter={StaticResource WidthAdjusterConverter}, ConverterParameter=3}" CornerRadius="0" >
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Name="_menuItemsReset" TokeiLibrary:WpfProperties.ImagePath="refresh.png" Header="Reset value" Click="_menuItemsReset_Click" />
                <MenuItem Name="_menuItemsSelect" TokeiLibrary:WpfProperties.ImagePath="arrowdown.png" Header="Select in explorer" Click="_menuItemsSelect_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image Visibility="Collapsed"  TokeiLibrary:WpfProperties.ImagePath="warning16.png" HorizontalAlignment="Left" Name="_imgError" Width="16" Height="16" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock Name="_tblockDescription" Text="" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="3" />
            </Grid>
            <Rectangle Name="_tRectangleOverlay" Fill="Transparent" Grid.Column="0" Grid.ColumnSpan="2"  />
            <Styles:PathBrowser x:Name="_tbText" Grid.Column="3" UseSavePath="True" Filter="Common Files (*.txt;*.lua;*.lub)|*.txt;*.lua;*.lub|Text Files (*.txt)|*.txt|Lua Files (*.lua)|*.lua|Lub Files (*.lub)|*.lub" BrowseMode="File" SavePathUniqueName="Server database editor - TVI - Browse" />
            <Button Name="_buttonReset" TokeiLibrary:WpfProperties.ImagePath="reset.png" Click="_buttonReset_Click" Grid.Row="1" Grid.Column="5" Height="25" Width="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
