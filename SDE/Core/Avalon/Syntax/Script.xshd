<?xml version="1.0"?>
<SyntaxDefinition name="Script" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="Green" />
  <Color name="Error" fontWeight="bold" foreground="Red" />
  <Color name="String" foreground="Gray" />
  <Color name="Label" foreground="#000DBA" />
  <Color name="Orange" fontWeight="bold" foreground="#FFDA7000" />
  <Color name="Goto" fontWeight="bold" foreground="DarkBlue" />
  <Color name="KeywordsStructure" foreground="Blue" />
  <Color name="KeywordsDb" fontStyle="italic" foreground="#00B000" />
  <Color name="KeywordsApi" foreground="#638AFF" />
  <Color name="KeywordsOthers" fontStyle="italic" foreground="#ff0000" />
  <Color name="KeywordsDigit" foreground="Orange" />
  <Color name="KeywordsConstant" foreground="#069906" />
	
	<!-- This is the main ruleset. -->
	<RuleSet ignoreCase="true">
    <Span color="Comment" begin="//" />
    <Span color="Error" begin="-- DECOMPILER ERROR" />
    <Span color="Error" begin="-- GRF Editor Decompiler" />
    <Span color="Orange" begin="-- Using GRF Editor Decompiler" />
    
    <Span color="Comment" begin="--" />
    <Span color="Comment" multiline="true" begin="--\[\[" end="--\]\]" />
    <Span color="Goto" begin="::" end="::" />
    <Span color="Goto" begin="goto " />

    <Span color="String">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<!-- nested span for escape sequences -->
				<Span begin="\\" end="." />
			</RuleSet>
		</Span>

    <Span color="String">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <!-- nested span for escape sequences -->
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    
    <Keywords color="KeywordsStructure">
			<Word>DELETE</Word>
    </Keywords>

    <Keywords color="KeywordsConstant">
			<Word>DELETE</Word>
    </Keywords>

      <!-- Digits -->
		<Rule color="KeywordsDigit">
            \b0[xX][0-9a-fA-F]+  # hex number
        |    \b
            (    \d+(\.[0-9]+)?   #number with optional floating point
            |    \.[0-9]+         #or just starting with floating point
            )
            ([eE][+-]?[0-9]+)? # optional exponent
        </Rule>
	</RuleSet>
</SyntaxDefinition>