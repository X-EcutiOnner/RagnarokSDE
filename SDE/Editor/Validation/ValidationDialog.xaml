<Styles:TkWindow x:Class="SDE.Editor.Validation.ValidationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
        xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
        xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
        xmlns:SdeConfig="clr-namespace:SDE.ApplicationConfiguration" xmlns:controls="clr-namespace:SDE.Databases.Generic.Controls"
				 Width="600" Height="450" 
		SnapsToDevicePixels="True" UseLayoutRounding="True"
        Background="{DynamicResource TabItemBackground}" Foreground="{DynamicResource TextForeground}">
	<Styles:TkWindow.Resources>
		<Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
			<Setter Property="Margin" Value="3" />
		</Style>
	</Styles:TkWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource TabControlBackground}">
            <TabControl Name="_tabControl" Style="{DynamicResource TabControlStyled}" Foreground="{DynamicResource TextForeground}">
                <TabItem Header="Table errors" Style="{DynamicResource TabItemStyled}" Foreground="{DynamicResource TextForeground}">
                    <StackPanel>
                        <StackPanel>
                            <Label Content="Table errors" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" Foreground="{DynamicResource TextForeground}"/>
                            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
                        </StackPanel>

                        <Styles:FancyButton Click="_buttonTableErrors_Click" x:Name="_buttonTableErrors" TextHeader="Table errors" TextDescription="Look for errors in the server tables" Margin="3" HorizontalAlignment="Left" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Resource errors" Style="{DynamicResource TabItemStyled}" Foreground="{DynamicResource TextForeground}">
                    <StackPanel>
                        <StackPanel>
                            <Label Content="Resource errors" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" Foreground="{DynamicResource TextForeground}" />
                            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
                        </StackPanel>

                        <Styles:FancyButton Click="_buttonFindErrors_Click" x:Name="_buttonFindErrors" TextHeader="Resource errors" TextDescription="Look for texture or sprite errors" Margin="3" HorizontalAlignment="Left" />
                        <CheckBox Foreground="{DynamicResource TextForeground}" Name="_cbResSelectAll" Content="Select all" Margin="3" HorizontalAlignment="Left" />
                        <TextBlock Text="Errors to look for :" Margin="3" />
						<Grid Name="_findErrors">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="auto" />
								<ColumnDefinition Width="auto" />
							</Grid.ColumnDefinitions>
							<StackPanel>
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResExistingOnly), Mode=TwoWay}" Content="Only look for existing item_db entries" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResInventory), Mode=TwoWay}" Content="Missing inventory images" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResIllustration), Mode=TwoWay}" Content="Missing card illustration images" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResCollection), Mode=TwoWay}" Content="Missing collection images" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResDrag), Mode=TwoWay}" Content="Missing drag sprites" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResShield), Mode=TwoWay}" Content="Missing shield sprites" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResGarment), Mode=TwoWay}" Content="Missing garment sprites" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResWeapon), Mode=TwoWay}" Content="Missing weapon sprites" />
							</StackPanel>
							<StackPanel Grid.Column="1">
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResHeadgear), Mode=TwoWay}" Content="Missing headgear sprites" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResNpc), Mode=TwoWay}" Content="Missing NPC sprites" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResMonster), Mode=TwoWay}" Content="Missing monster sprites" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResInvalidFormat), Mode=TwoWay}" Content="Validate image formats" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResEmpty), Mode=TwoWay}" Content="Empty resource warning" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResInvalidCharacters), Mode=TwoWay}" Content="Invalid chars warning" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaResClientItemMissing), Mode=TwoWay}" Content="Missing client item warning" />
							</StackPanel>
						</Grid>
					</StackPanel>
                </TabItem>
                <TabItem Header="Client Items" Style="{DynamicResource TabItemStyled}" Foreground="{DynamicResource TextForeground}">
                    <StackPanel>
                        <StackPanel>
                            <Label Content="Client Items" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" Foreground="{DynamicResource TextForeground}" />
                            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
                        </StackPanel>

                        <Styles:FancyButton Click="_buttonScanClientItems_Click" x:Name="_buttonScanClientItems" TextHeader="Scan Client Items" TextDescription="Look for item description errors" Margin="3" HorizontalAlignment="Left" />
                        <CheckBox Foreground="{DynamicResource TextForeground}" Name="_cbCiSelectAll" Content="Select all" Margin="3" HorizontalAlignment="Left" />
                        <TextBlock Text="Errors to look for :" Margin="3" />
                        <Grid Name="_scanClientItems">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
							<StackPanel>
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiViewId), Mode=TwoWay}" Content="View ID (Class number)" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiItemRange), Mode=TwoWay}" Content="Invalid item ID range" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiDescription), Mode=TwoWay}" Content="Item description" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiClass), Mode=TwoWay}" Content="Invalid value for Class field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiAttack), Mode=TwoWay}" Content="Invalid value for Attack field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiDefense), Mode=TwoWay}" Content="Invalid value for Defense field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiProperty), Mode=TwoWay}" Content="Invalid value for Property field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiJob), Mode=TwoWay}" Content="Invalid value for Applicable Job field" />
                            </StackPanel>
							<StackPanel Grid.Column="1">
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiRequiredLevel), Mode=TwoWay}" Content="Invalid value for RequiredLevel field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiWeaponLevel), Mode=TwoWay}" Content="Invalid value for WeaponLevel field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiWeight), Mode=TwoWay}" Content="Invalid value for Weight field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiLocation), Mode=TwoWay}" Content="Invalid value for Location field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiCompoundOn), Mode=TwoWay}" Content="Invalid value for CompoundOn field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiName), Mode=TwoWay}" Content="Invalid value for Name field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiIsCard), Mode=TwoWay}" Content="Invalid value for IsCard field" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.VaCiNumberOfSlots), Mode=TwoWay}" Content="Invalid value for NumberOfSlots field" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>
                <TabItem Name="_tabItemResults" Header="Results" Style="{DynamicResource TabItemStyled}" Foreground="{DynamicResource TextForeground}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Label Name="_lbResults" Content="Results" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" Foreground="{DynamicResource TextForeground}" />
                            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1">
                            <Styles:FancyButton x:Name="_buttonRawView" Click="_buttonRawView_Click" Grid.Row="0" Grid.Column="0" Height="43" TextHeader="Raw view" TextDescription="Show the raw view" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <!--<WPF:FancyButton Margin="3" Click="_buttonFixAll_Click" x:Name="_buttonFixAll" TextHeader="Fix all" TextDescription="Fix all items" HorizontalAlignment="Left" />-->
                        </WrapPanel>
                        <ListView TextSearch.TextPath="Id" ListView:ListViewExtensions.IsGridSortable="True" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseRightButtonUp="_listViewResults_PreviewMouseRightButtonUp"  Name="_listViewResults" BorderThickness="0" Grid.Row="2" />
                        <TextBox BorderThickness="0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Name="_tbResults" IsReadOnly="True" Grid.Row="2" AcceptsTab="True" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <Grid TokeiLibrary:WpfProperties.IsDraggable="True" Grid.Row="1" Height="40" Background="{DynamicResource UIDialogBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Styles:TkProgressBar x:Name="_progressBar" Margin="3 0 0 0" />
                <DockPanel HorizontalAlignment="Right" Grid.Column="1" Margin="0 0 3 0">
                    <Button Name="_buttonCancel" Content="Close" Height="25" Width="100" Click="_buttonCancel_Click" Margin="3" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Styles:TkWindow>
