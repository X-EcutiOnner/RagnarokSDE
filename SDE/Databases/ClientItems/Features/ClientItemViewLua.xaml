<UserControl x:Class="SDE.Databases.ClientItems.Features.ClientItemViewLua"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDE.Databases.Quests.Features"
			 xmlns:f="clr-namespace:SDE.Databases.Generic.Controls"
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:Avalon="clr-namespace:SDE.Core.Avalon"
             xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
             xmlns:Tmc="clr-namespace:SDE.Editor.Generic.DbTabs"
             xmlns:Converters="clr-namespace:SDE.Databases.Generic.Converters"
			 xmlns:wpfbugfix="clr-namespace:TokeiLibrary.WpfBugFix;assembly=TokeiLibrary"
             xmlns:Common="clr-namespace:SDE.Databases.Generic.Common"
			 xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary" 
			 xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
			 xmlns:controls="clr-namespace:SDE.Databases.ClientItems.Controls"
			 Foreground="{DynamicResource TextForeground}"
			 mc:Ignorable="d" 
			 MaxWidth="800"
			 HorizontalAlignment="Left"
			 d:DesignWidth="800">
	<UserControl.Resources>
		<Converters:ItemPreviewConverter x:Key="ItemPreviewConverter"/>
		<Converters:MobPreviewConverter x:Key="MobPreviewConverter"/>
		<Converters:WidthToGridLengthConverter x:Key="WidthToGridLengthConverter"/>
	</UserControl.Resources>
	<Grid x:Name="_gridContainer" IsEnabled="{Binding IsModelValid}">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<f:HorizontalGrid ColumnCount="2" AllLabelColumnSameSize="True" x:Name="_gridProperties">
			<f:Property Label="Item ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Id}">
				<f:Property.Editor>
					<f:ValidationTextBox IsReadOnly="True" Text="{Binding Id}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:EditKeyButton SourceField="{Binding Id}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Card" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding IsCard}">
				<f:Property.Editor>
					<CheckBox IsChecked="{Binding IsCard}" VerticalAlignment="Center" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="View ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding ClassNumber}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding ClassNumber, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<Button Width="22" Height="22" Margin="3 0 0 0" TokeiLibrary:WpfProperties.ImagePath="settings.png" Click="_bLuaSettings_Click" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Illustration" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Illustration}" IsEnabled="{Binding IsCard}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Illustration, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectResourceButton Source="Card" AutoComplete="Collapsed" SourceField="{Binding Illustration}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Number of slots " Tmc:DisplayablePropertyHelper.SearchBinding="{Binding NumberOfSlots}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding NumberOfSlots, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Affix" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Affix}" IsEnabled="{Binding IsCard}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Affix, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Costume" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding IsCostume}">
				<f:Property.Editor>
					<CheckBox IsChecked="{Binding IsCostume}" VerticalAlignment="Center" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Postfix" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding IsPostfix}">
				<f:Property.Editor>
					<CheckBox IsChecked="{Binding IsPostfix}" VerticalAlignment="Center" />
				</f:Property.Editor>
			</f:Property>

			<TextBlock Style="{StaticResource DbTextBlock}" Margin="3 10 3 3" Text="Identified" FontStyle="Italic" />

			<TextBlock Style="{StaticResource DbTextBlock}" Margin="3 10 3 3" Text="Unidentified" FontStyle="Italic" />

			<f:Property Label="Resource name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding IdentifiedResourceName}">
				<f:Property.Editor>
					<TextBox Text="{Binding IdentifiedResourceName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
						<TextBox.Style>
							<Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IdentifiedResourceNameValid}" Value="False">
										<Setter Property="Background" Value="{StaticResource GSearchEngineError}"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBox.Style>
					</TextBox>
				</f:Property.Editor>
				<f:Property.Extras>
					<f:ItemImage SourceField="{Binding IdentifiedResourceName}" DataValid="{Binding IdentifiedResourceNameValid}" Height="24" />
					<f:SelectResourceButton Source="Collection" SourceField="{Binding IdentifiedResourceName}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Resource name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding UnidentifiedResourceName}">
				<f:Property.Editor>
					<TextBox Text="{Binding UnidentifiedResourceName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
						<TextBox.Style>
							<Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding UnidentifiedResourceNameValid}" Value="False">
										<Setter Property="Background" Value="{StaticResource GSearchEngineError}"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBox.Style>
					</TextBox>
				</f:Property.Editor>
				<f:Property.Extras>
					<f:ItemImage SourceField="{Binding UnidentifiedResourceName}" DataValid="{Binding UnidentifiedResourceNameValid}" Height="24" />
					<f:SelectResourceButton Source="Collection" SourceField="{Binding UnidentifiedResourceName}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Display name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding IdentifiedDisplayName}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding IdentifiedDisplayName, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Display name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding UnidentifiedDisplayName}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding UnidentifiedDisplayName, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>
		</f:HorizontalGrid>
		<Grid x:Name="_testGrid" Grid.Row="1" Grid.IsSharedSizeScope="True">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding ElementName=_gridProperties, Path=ColumnWidths[0]}" />
				<ColumnDefinition Width="{Binding ElementName=_gridProperties, Path=ColumnWidths[1]}" />
				<ColumnDefinition Width="{Binding ElementName=_gridProperties, Path=ColumnWidths[2]}" />
				<ColumnDefinition Width="{Binding ElementName=_gridProperties, Path=ColumnWidths[3]}" />
				<ColumnDefinition Width="{Binding ElementName=_gridProperties, Path=ColumnWidths[4]}" />
				<ColumnDefinition Width="auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition Height="auto" />
			</Grid.RowDefinitions>
			<StackPanel>
				<TextBlock Text="Description" Margin="3" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding IdentifiedDescription}" />
				<Button Height="22" Margin="3" Content="Quick edit..." Click="_buttonQuickEdit_Click" />
				<Button Height="22" Margin="3" Content="Item bonus" Click="_buttonItemBonus_Click" />
				<TextBlock Text="Color picker" Margin="3" />
				<controls:TextEditorColorPicker x:Name="_tecc" />
			</StackPanel>
			<Border Grid.Column="1" BorderThickness="1" BorderBrush="{x:Static SystemColors.ActiveBorderBrush}" Margin="3">
				<avalonedit:TextEditor x:Name="_tbIdDescription" MinHeight="75"
									   HorizontalScrollBarVisibility="Auto" 
									   VerticalScrollBarVisibility="Auto" 
									   ShowLineNumbers="True" 
									   FontFamily="Consolas" 
									   WordWrap="True" 
									   Avalon:AvalonEditBinding.Text="{Binding IdentifiedDescription}" />
			</Border>
			
			<StackPanel Grid.Column="3">
				<TextBlock Text="Description" Margin="3" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding UnidentifiedDescription}" />
				<Button Height="22" Margin="3" Content="Copy >" Command="{Binding CopyIdDescToUnDescCommand}" />
			</StackPanel>

			<Border Grid.Column="4" BorderThickness="1" BorderBrush="{x:Static SystemColors.ActiveBorderBrush}" Margin="3">
				<avalonedit:TextEditor x:Name="_tbUnDescription" MinHeight="75"
						   HorizontalScrollBarVisibility="Auto" 
						   VerticalScrollBarVisibility="Auto" 
						   ShowLineNumbers="True" 
						   FontFamily="Consolas" 
						   WordWrap="True" 
						   Avalon:AvalonEditBinding.Text="{Binding UnidentifiedDescription}" />
			</Border>

			<controls:ClientItemDescriptionPreview HorizontalAlignment="Center" Grid.Row="1" Grid.ColumnSpan="2" Margin="3" DisplayName="{Binding IdentifiedDisplayName}" Resource="{Binding IdentifiedResourceName}" PreviewDescription="{Binding IdentifiedDescription}" />
			<controls:ClientItemDescriptionPreview HorizontalAlignment="Center" Grid.Row="1" Grid.ColumnSpan="2" Margin="3" DisplayName="{Binding UnidentifiedDisplayName}" Resource="{Binding UnidentifiedResourceName}" PreviewDescription="{Binding UnidentifiedDescription}" Grid.Column="3" />
		</Grid>
	</Grid>
</UserControl>
