<UserControl x:Class="SDE.Databases.ClientItems.Controls.ClientItemDescriptionPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	    x:Name="Root"
        mc:Ignorable="d">
    <Border BorderBrush="#FF7D7DFF" Height="124" CornerRadius="3" BorderThickness="2" Width="284" >
        <Grid Height="120" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image Name="_resImage" HorizontalAlignment="Left" Source="/Resources/collection_bg.png" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Top" SnapsToDevicePixels="True" Stretch="None" />
			<Image Name="_image" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Top" SnapsToDevicePixels="True" Stretch="None" Margin="10 11 0 0" />
            <ScrollViewer Width="180" Height="76" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90 34 0 0" Background="Transparent">
                <RichTextBox IsReadOnly="True" Name="_rtbItemDescription" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" >
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </ScrollViewer>
			<Label Content="{Binding DisplayName, ElementName=Root}" HorizontalAlignment="Left" Foreground="{DynamicResource PreviewItemTextBackground}" VerticalAlignment="Top" Margin="91 1 0 0" FontSize="12" />
			<Label Name="_cardName" Content="{Binding DisplayName, ElementName=Root}" HorizontalAlignment="Left" Foreground="{DynamicResource PreviewItemTextForeground}" VerticalAlignment="Top" Margin="90 2 0 0" FontSize="12" />
        </Grid>
    </Border>
</UserControl>
