<UserControl x:Class="SDE.Databases.Generic.Controls.SelectTupleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:local="clr-namespace:SDE.Databases.Generic.Controls"
			 xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
			 mc:Ignorable="d" d:DesignWidth="22" d:DesignHeight="22" Width="22" Height="22" Margin="3 0 0 0">
    <Grid>
		<Button x:Name="_button" Click="_button_Click" TokeiLibrary:WpfProperties.ImagePath="arrowdown.png">
			<Button.ContextMenu>
				<ContextMenu Name="_contextMenu" Placement="Bottom">
					<styles:TkMenuItem x:Name="_miSelectFromList" TokeiLibrary:WpfProperties.ImagePath="treeList.png" Header="Select from..." Click="_selectFromList_Click" />
					<styles:TkMenuItem x:Name="_miSelect" TokeiLibrary:WpfProperties.ImagePath="find.png" Click="_select_Click" />
				</ContextMenu>
			</Button.ContextMenu>
		</Button>
	</Grid>
</UserControl>
