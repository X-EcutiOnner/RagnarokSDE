<UserControl x:Class="SDE.Databases.Generic.Controls.MobSpriteImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:local="clr-namespace:SDE.Databases.Generic.Controls"
			 xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
			 xmlns:actrenderer="clr-namespace:GrfToWpfBridge.ActRenderer;assembly=GrfToWpfBridge" xmlns:acteditor="clr-namespace:SDE.Tools.ActViewer"
			 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200">
	<Grid Focusable="True" FocusVisualStyle="{x:Null}" Name="_gridPrimary" Background="{DynamicResource TabItemBackground}" RenderOptions.BitmapScalingMode="NearestNeighbor">
		<Image x:Name="_image" RenderOptions.BitmapScalingMode="HighQuality" Stretch="None" />
	</Grid>
</UserControl>
