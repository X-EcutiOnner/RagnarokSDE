<UserControl x:Class="SDE.Databases.MobSkills.Features.MobSkillViewCsv"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDE.Databases.Quests.Features"
			 xmlns:f="clr-namespace:SDE.Databases.Generic.Controls"
			 xmlns:MobSkillFeatures="clr-namespace:SDE.Databases.MobSkills.Features"
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
             xmlns:Tmc="clr-namespace:SDE.Editor.Generic.DbTabs"
             xmlns:Converters="clr-namespace:SDE.Databases.Generic.Converters"
			 xmlns:wpfbugfix="clr-namespace:TokeiLibrary.WpfBugFix;assembly=TokeiLibrary"
             xmlns:Common="clr-namespace:SDE.Databases.MobSkills.Common"
			 xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
			 Foreground="{DynamicResource TextForeground}"
			 mc:Ignorable="d" 
			 MaxWidth="800"
			 HorizontalAlignment="Left"
			 d:DesignWidth="800">
	<UserControl.Resources>
		<Converters:ItemPreviewConverter x:Key="ItemPreviewConverter"/>
		<Converters:MobPreviewConverter x:Key="MobPreviewConverter"/>
		<Converters:SkillPreviewConverter x:Key="SkillPreviewConverter"/>
		<Converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
		<Converters:EmotePreviewConverter x:Key="EmotePreviewConverter"/>
	</UserControl.Resources>
	<Grid x:Name="_gridContainer" IsEnabled="{Binding IsModelValid}">
		<f:HorizontalGrid ColumnCount="2">
			<f:Property Label="Mob ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding MobId}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding MobId, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding MobId, Converter={StaticResource MobPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Mobs" SourceField="{Binding MobId}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Display name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding FriendlyDisplay}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding FriendlyDisplay, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<MobSkillFeatures:SetDisplayName Width="22" Height="22" Margin="3 0 0 0" SourceField="{Binding FriendlyDisplay}" DestinationField="{Binding FriendlyDisplay}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="State" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding State}">
				<f:Property.Editor>
					<ComboBox ItemsSource="{Binding Path=(Common:MobSkillStateTypeInfo.AllVisibleOnly)}" SelectedItem="{Binding State, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Skill ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SkillId}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding SkillId, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding SkillId, Converter={StaticResource SkillPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Skills" SourceField="{Binding SkillId}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Skill level" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SkillLv}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding SkillLv, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Rate" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Rate}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:RateEditButton SourceField="{Binding Rate}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Cast time" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding CastTime}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding CastTime, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:TimeEditButton SourceField="{Binding CastTime}" Millisecond="True" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Delay" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Delay}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:TimeEditButton SourceField="{Binding Delay}" Millisecond="True" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Cancelable" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Cancelable}">
				<f:Property.Editor>
					<CheckBox IsChecked="{Binding Cancelable}" VerticalAlignment="Center" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Target" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Target}">
				<f:Property.Editor>
					<ComboBox ItemsSource="{Binding Path=(Common:MobSkillTargetTypeInfo.AllVisibleOnly)}" SelectedItem="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Condition type" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Cond1}">
				<f:Property.Editor>
					<ComboBox ItemsSource="{Binding Path=(Common:MobSkillCond1TypeInfo.AllVisibleOnly)}" SelectedItem="{Binding Cond1, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Condition value" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding CValue}">
				<f:Property.Editor>
					<Grid>
						<f:ValidationTextBox Text="{Binding CValue, UpdateSourceTrigger=PropertyChanged}" />
						<ComboBox ItemsSource="{Binding Path=(Common:MobSkillCond2TypeInfo.AllVisibleOnly)}" SelectedItem="{Binding CValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsCValueEnum, Converter={StaticResource BooleanToVisibilityConverter}}" />
					</Grid>
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Val1" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Val1}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Val1, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>
			
			<f:Property Label="Val2" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Val2}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Val2, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Val3" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Val3}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Val3, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Val4" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Val4}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Val4, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Val5" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Val5}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Val5, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Emotion" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Emotion}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Emotion, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Emotion, Converter={StaticResource EmotePreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Emotes" SourceField="{Binding Emotion}" SelectVisiblity="Collapsed" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Chat" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Chat}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Chat, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>
		</f:HorizontalGrid>
	</Grid>
</UserControl>
