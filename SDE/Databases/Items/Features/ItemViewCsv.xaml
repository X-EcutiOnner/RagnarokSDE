<UserControl x:Class="SDE.Databases.Items.Features.ItemViewCsv"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDE.Databases.Quests.Features"
			 xmlns:f="clr-namespace:SDE.Databases.Generic.Controls"
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
             xmlns:Tmc="clr-namespace:SDE.Editor.Generic.DbTabs"
             xmlns:Converters="clr-namespace:SDE.Databases.Generic.Converters"
             xmlns:ItemConverters="clr-namespace:SDE.Databases.Items.Converters"
			 xmlns:wpfbugfix="clr-namespace:TokeiLibrary.WpfBugFix;assembly=TokeiLibrary"
             xmlns:Common="clr-namespace:SDE.Databases.Generic.Common"
             xmlns:ItemCommon="clr-namespace:SDE.Databases.Items.Common"
             xmlns:Controls="clr-namespace:SDE.Databases.Items.Controls"
			 xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 Foreground="{DynamicResource TextForeground}"
			 mc:Ignorable="d" 
			 MaxWidth="800"
			 HorizontalAlignment="Left"
             d:DesignWidth="800">
	<UserControl.Resources>
		<Converters:ItemPreviewConverter x:Key="ItemPreviewConverter"/>
		<Converters:MobPreviewConverter x:Key="MobPreviewConverter"/>
		<Converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
		<ItemConverters:ItemTypeToVisibilityConverter x:Key="ItemTypeToVisibilityConverter"/>
	</UserControl.Resources>
	<Grid x:Name="_gridContainer" IsEnabled="{Binding IsModelValid}">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<f:HorizontalGrid ColumnCount="2">
			<f:Property Label="Item ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Id}" >
				<f:Property.Editor>
					<f:ValidationTextBox IsReadOnly="True" Text="{Binding Id}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:EditKeyButton SourceField="{Binding Id}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Type" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Type}" >
				<f:Property.Editor>
					<ComboBox ItemsSource="{Binding Path=(ItemCommon:ItemTypeInfo.AllVisibleOnly)}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>
			
			<f:Property Label="Aegis name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding AegisName}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding AegisName}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<Controls:AegisNameButton SourceField="{Binding Name}" DestinationField="{Binding AegisName}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Name}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Name}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<Controls:NameButton SourceField="{Binding AegisName}" DestinationField="{Binding Name}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Buy" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Buy}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Buy}" PreviewText="{Binding BuyPreview}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Sell" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Sell}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Sell}" PreviewText="{Binding SellPreview}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Weight" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Weight}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Weight}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Attack" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Attack}" >
				<f:Property.Editor>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition>
								<ColumnDefinition.Style>
									<Style TargetType="ColumnDefinition">
										<Setter Property="Width" Value="Auto" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding Renewal}" Value="False">
												<Setter Property="Width" Value="0" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ColumnDefinition.Style>
							</ColumnDefinition>
							<ColumnDefinition>
								<ColumnDefinition.Style>
									<Style TargetType="ColumnDefinition">
										<Setter Property="Width" Value="*" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding Renewal}" Value="False">
												<Setter Property="Width" Value="0" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ColumnDefinition.Style>
							</ColumnDefinition>
						</Grid.ColumnDefinitions>
						<f:ValidationTextBox Text="{Binding Attack}" />
						<TextBlock Text="Matk" Grid.Column="1" VerticalAlignment="Center" Margin="3" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding MagicAttack}" Visibility="{Binding Renewal, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<f:ValidationTextBox Text="{Binding MagicAttack}" Grid.Column="2" Visibility="{Binding Renewal, Converter={StaticResource BooleanToVisibilityConverter}}" />
					</Grid>
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Defense" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Defense}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Defense}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Range" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Range}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Range}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Slots" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Slots}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Slots}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Jobs" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Jobs}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Jobs}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<Controls:JobEditButton SourceField="{Binding Jobs}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Upper" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Classes}" >
				<f:Property.Editor>
					<f:ValidationFlagEdit Text="{Binding Classes, UpdateSourceTrigger=PropertyChanged}" SourceType="{x:Type Common:ItemJobFlag}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Gender" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Gender}" >
				<f:Property.Editor>
					<ComboBox ItemsSource="{Binding Path=(Common:GenderTypeInfo.AllVisibleOnly)}" SelectedItem="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Location" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Locations}" >
				<f:Property.Editor>
					<f:ValidationFlagEdit Text="{Binding Locations, UpdateSourceTrigger=PropertyChanged}" SourceType="{x:Type ItemCommon:EquipLocationFlag}" />
				</f:Property.Editor>
			</f:Property>
			
			<f:Property Label="Weapon level" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding WeaponLevel}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding WeaponLevel}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Min equip level" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding EquipLevelMin}" >
				<f:Property.Editor>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition Width="auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<f:ValidationTextBox Text="{Binding EquipLevelMin}" />
						<TextBlock Text="Max" Grid.Column="1" VerticalAlignment="Center" Margin="3" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding EquipLevelMax}" />
						<f:ValidationTextBox Text="{Binding EquipLevelMax}" Grid.Column="2" />
					</Grid>
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Refineable" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Refineable}" >
				<f:Property.Editor>
					<CheckBox IsChecked="{Binding Refineable}" VerticalAlignment="Center" />
				</f:Property.Editor>
			</f:Property>
			
			<f:Property Label="View ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding View}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding View}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:ViewIdButton />
					<f:LuaTableButton />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Script" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Script}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Script}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:ScriptEditButton SourceField="{Binding Script}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="On equip script" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding EquipScript}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding EquipScript}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:ScriptEditButton SourceField="{Binding EquipScript}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="On unequip script" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding UnEquipScript}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding UnEquipScript}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:ScriptEditButton SourceField="{Binding UnEquipScript}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Alias name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding AliasName}" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding AliasName}" PreviewText="{Binding AliasName, Converter={StaticResource ItemPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton SourceField="{Binding AliasName}" Source="Items" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Flags" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Flags}" >
				<f:Property.Editor>
					<f:ValidationFlagEdit Text="{Binding Flags, UpdateSourceTrigger=PropertyChanged}" SourceType="{x:Type ItemCommon:ItemFlag}" />
				</f:Property.Editor>
			</f:Property>
		</f:HorizontalGrid>
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="auto" />
				<RowDefinition />
			</Grid.RowDefinitions>
			<TextBlock Style="{StaticResource DbTextBlock}" Text="Dropped by" FontStyle="Italic" Margin="3 10 3 3" />
			<TextBlock Style="{StaticResource DbTextBlock}" Text="Others" FontStyle="Italic" Margin="3 10 3 3" Grid.Column="2" />

			<wpfbugfix:RangeListView x:Name="_lvMobDrops" Grid.Row="1" Grid.Column="0"
				TextSearch.TextPath="Mob"
				Margin="3"
				BorderThickness="1"
				ListView:ListViewExtensions.IsGridSortable="True"
				ScrollViewer.HorizontalScrollBarVisibility="Disabled"
				ItemsSource="{Binding MobDrops, UpdateSourceTrigger=PropertyChanged}"
				IsHitTestVisible="{Binding IsModelValid}"
				ListView:ListViewLayoutManager.Enabled="True"
				SelectionChanged="_lvMobDrops_SelectionChanged"
				FocusVisualStyle="{x:Null}">
			</wpfbugfix:RangeListView>

			<f:HorizontalGrid ColumnCount="2" Grid.Row="1" Grid.Column="2" SeparatorWidth="0">
				<f:Property Label="Trade" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding TradeFlags}" >
					<f:Property.Editor>
						<f:ValidationFlagEdit Text="{Binding TradeFlags, UpdateSourceTrigger=PropertyChanged}" SourceType="{x:Type ItemCommon:TradeFlag}" />
					</f:Property.Editor>
				</f:Property>
				
				<f:Property Label="Override" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding TradeOverride}" >
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding TradeOverride}" />
					</f:Property.Editor>
				</f:Property>

				<f:Property Label="No use" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding NoUseFlags}" >
					<f:Property.Editor>
						<f:ValidationFlagEdit Text="{Binding NoUseFlags, UpdateSourceTrigger=PropertyChanged}" SourceType="{x:Type ItemCommon:NoUseFlag}" />
					</f:Property.Editor>
				</f:Property>

				<f:Property Label="Override" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding NoUseOverride}" >
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding NoUseOverride}" />
					</f:Property.Editor>
				</f:Property>

				<f:Property Label="Stack" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding StackAmount}" >
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding StackAmount}" />
					</f:Property.Editor>
				</f:Property>

				<f:Property Label="Stack flags" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding StackFlags}" >
					<f:Property.Editor>
						<f:ValidationFlagEdit Text="{Binding StackFlags, UpdateSourceTrigger=PropertyChanged}" SourceType="{x:Type ItemCommon:ItemStackFlag}" />
					</f:Property.Editor>
				</f:Property>

				<f:Property Label="Delay" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Delay}" >
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding Delay}" />
					</f:Property.Editor>
					<f:Property.Extras>
						<f:TimeEditButton SourceField="{Binding Delay}" Millisecond="True" Width="30" />
					</f:Property.Extras>
				</f:Property>

				<f:Property Label="Status" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding DelayStatus}" >
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding DelayStatus}" />
					</f:Property.Editor>
				</f:Property>
			</f:HorizontalGrid>
		</Grid>
	</Grid>
</UserControl>
