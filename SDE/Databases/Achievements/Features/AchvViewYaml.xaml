<UserControl x:Class="SDE.Databases.Achievements.Features.AchvViewYaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDE.Databases.Quests.Features"
			 xmlns:f="clr-namespace:SDE.Databases.Generic.Controls"
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
             xmlns:Tmc="clr-namespace:SDE.Editor.Generic.DbTabs"
             xmlns:Converters="clr-namespace:SDE.Databases.Generic.Converters"
			 xmlns:wpfbugfix="clr-namespace:TokeiLibrary.WpfBugFix;assembly=TokeiLibrary"
             xmlns:Common="clr-namespace:SDE.Databases.Achievements.Common"
			 xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary" xmlns:properties="clr-namespace:SDE.Databases.Achievements.Properties"
			 Foreground="{DynamicResource TextForeground}"
			 mc:Ignorable="d" 
			 HorizontalAlignment="Left"
			 VerticalAlignment="Top"
			 MinHeight="600"
			 MaxHeight="600"
			 MaxWidth="800"
             d:DesignWidth="800">
	<UserControl.Resources>
		<Converters:ItemPreviewConverter x:Key="ItemPreviewConverter"/>
		<Converters:MobPreviewConverter x:Key="MobPreviewConverter"/>
		<Converters:MobNameConverter x:Key="MobNameConverter"/>
		<Converters:ListViewIndexConverter x:Key="ListViewIndexConverter"/>
		<Converters:AchvNameConverter x:Key="AchvNameConverter"/>

		<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
		</Style>
	</UserControl.Resources>
	<Grid x:Name="_gridContainer" IsEnabled="{Binding IsModelValid}">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<f:HorizontalGrid ColumnCount="2">
			<f:Property Label="Achievement ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Id}" ToolTip="Achievement ID." >
				<f:Property.Editor>
					<f:ValidationTextBox IsReadOnly="True" Text="{Binding Id}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:EditKeyButton SourceField="{Binding Id}" />
				</f:Property.Extras>
			</f:Property>

			<f:Separator />

			<f:Property Label="Name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Name}" ToolTip="Achievement name." >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Group ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Group}" ToolTip="Achievement group type. (Defaut: None)" >
				<f:Property.Editor>
					<ComboBox ItemsSource="{Binding Path=(Common:AchvGroupTypeInfo.AllVisibleOnly)}" SelectedItem="{Binding Group, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<TextBlock Style="{StaticResource DbTextBlock}" Margin="3 10 3 3" Text="Rewards" FontStyle="Italic" />
			<f:Separator />

			<f:Property Label="Item ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding RewardItem}" ToolTip="Item name." >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding RewardItem, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding RewardItem, Converter={StaticResource ItemPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Items" SourceField="{Binding RewardItem}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Amount" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding RewardAmount}" ToolTip="Amount of item. (Default: 1)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding RewardAmount, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Script" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding RewardScript}" ToolTip="Amount of item. (Default: 1)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding RewardScript, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:ScriptEditButton SourceField="{Binding RewardScript}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Title ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding RewardTitleId}" ToolTip="Amount of item. (Default: 1)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding RewardTitleId, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Score" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Score}" ToolTip="Achievement points that are given on completion. (Default: 0)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Score, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>
			<f:Separator/>

			<TextBlock Style="{StaticResource DbTextBlock}" Margin="3 10 3 3" Text="Requirements" FontStyle="Italic" />
			<f:Separator />

			<f:Property Label="Condition" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Condition}" ToolTip="Conditional statement that must be met for the achievement to be considered complete. (Default: null)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:ScriptEditButton SourceField="{Binding Condition}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Map" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Map}" ToolTip="Map name that is used for the AG_CHATTING type. (Default: -1)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Map, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<TextBlock Style="{StaticResource DbTextBlock}" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets}" Margin="3 10 3 3" Text="Targets" FontStyle="Italic" />
			<TextBlock Style="{StaticResource DbTextBlock}" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Dependents}" Margin="3 10 3 3" Text="Dependents" FontStyle="Italic" />
		</f:HorizontalGrid>
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="10" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<wpfbugfix:RangeListView Grid.Column="0"
				Margin="3"
				Name="_lvTargets"
				ItemsSource="{Binding Targets}"
				SelectionChanged="_lvTargets_SelectionChanged"
				ItemContainerStyle="{StaticResource DefaultListViewItemStyle}"
				ListView:ListViewLayoutManager.Enabled="True"
				FocusVisualStyle="{x:Null}">
				<wpfbugfix:RangeListView.View>
					<GridView AllowsColumnReorder="False">
						<GridViewColumn Header="Id" Width="30">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<f:ValidationTextBox Margin="-6 0 -3 0" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" OnlyShowPreviewOnEmptyField="True" TextAlignment="Right" PreviewText="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource ListViewIndexConverter}}" />
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>

						<GridViewColumn Header="Mob name" ListView:ProportionalColumn.Width="5">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Margin="-3 0" Grid.Column="1" Text="{Binding Mob, Converter={StaticResource MobNameConverter}}" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}" />
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>

						<GridViewColumn Header="Mob ID" ListView:ProportionalColumn.Width="5">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<Grid Margin="-3 0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition />
											<ColumnDefinition Width="auto" />
										</Grid.ColumnDefinitions>
										<TextBox Text="{Binding Mob, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
										<f:SelectTupleButton Grid.Column="1" Source="Mobs" SourceField="{Binding Mob}" />
									</Grid>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>

						<GridViewColumn Header="Count" Width="50">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBox Margin="-3 0 -2 0" MinHeight="22" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
					</GridView>
				</wpfbugfix:RangeListView.View>
			</wpfbugfix:RangeListView>

			<wpfbugfix:RangeListView Grid.Column="2"
				Margin="3"
				Name="_lvDependents"
				ItemsSource="{Binding Dependents}"
				SelectionChanged="_lvDependents_SelectionChanged"
				ItemContainerStyle="{StaticResource DefaultListViewItemStyle}"
				ListView:ListViewLayoutManager.Enabled="True"
				FocusVisualStyle="{x:Null}">
				<wpfbugfix:RangeListView.View>
					<GridView AllowsColumnReorder="False">
						<GridViewColumn Header="Achv name" ListView:ProportionalColumn.Width="5">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Margin="-6 0 -3 0" Text="{Binding Id, Converter={StaticResource AchvNameConverter}}" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}" />
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>

						<GridViewColumn Header="Acvh ID" ListView:ProportionalColumn.Width="5">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<Grid Margin="-3 0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition />
											<ColumnDefinition Width="auto" />
										</Grid.ColumnDefinitions>
										<TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
										<f:SelectTupleButton Grid.Column="1" Source="Achievement" SourceField="{Binding Id}" />
									</Grid>
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>

						<GridViewColumn Header="Active" Width="50">
							<GridViewColumn.CellTemplate>
								<DataTemplate>
									<CheckBox IsChecked="{Binding Active}" HorizontalAlignment="Center" VerticalAlignment="Center" />
								</DataTemplate>
							</GridViewColumn.CellTemplate>
						</GridViewColumn>
					</GridView>
				</wpfbugfix:RangeListView.View>
			</wpfbugfix:RangeListView>
		</Grid>
	</Grid>
</UserControl>
