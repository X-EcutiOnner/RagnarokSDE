<UserControl x:Class="SDE.Databases.Quests.Features.QuestViewCsv"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDE.Databases.Quests.Features"
             xmlns:Converters="clr-namespace:SDE.Databases.Generic.Converters"
			 xmlns:f="clr-namespace:SDE.Databases.Generic.Controls"
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:Tmc="clr-namespace:SDE.Editor.Generic.DbTabs"
			 xmlns:wpfbugfix="clr-namespace:TokeiLibrary.WpfBugFix;assembly=TokeiLibrary"
             xmlns:Common="clr-namespace:SDE.Databases.Generic.Common"
			 xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
			 Foreground="{DynamicResource TextForeground}"
			 mc:Ignorable="d" 
			 MaxWidth="800"
			 HorizontalAlignment="Left"
             d:DesignWidth="800">
	<UserControl.Resources>
		<Converters:ItemPreviewConverter x:Key="ItemPreviewConverter"/>
		<Converters:MobPreviewConverter x:Key="MobPreviewConverter"/>
	</UserControl.Resources>
	<Grid x:Name="_gridContainer" IsEnabled="{Binding IsModelValid}">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="auto" />
			<RowDefinition Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<f:HorizontalGrid ColumnCount="2" x:Name="_gridProperties">
			<TextBlock Style="{StaticResource DbTextBlock}" Text="Quest properties" FontStyle="Italic" />
			<f:Separator />

			<f:Property Label="Id" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Id}" Grid.Row="1" ToolTip="Quest ID.">
				<f:Property.Editor>
					<f:ValidationTextBox IsReadOnly="True" Text="{Binding Id}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:EditKeyButton SourceField="{Binding Id}" />
				</f:Property.Extras>
			</f:Property>
			<f:Separator />

			<f:Property Label="Title" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Title}" Grid.Row="2" ToolTip="Quest title.">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>
			<f:Separator />

			<f:Property Label="Time limit" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding TimeLimit}" Grid.Row="3" ToolTip="Amount of time before the quest expires. (Default: 0)">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding TimeLimit, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:TimeEditButton SourceField="{Binding TimeLimit}" />
				</f:Property.Extras>
			</f:Property>
		</f:HorizontalGrid>

		<f:HorizontalGrid Grid.Row="1" x:Name="_gridTargets" Margin="0 10 0 0" ColumnCount="2" SeparatorWidth="0" >
			<TextBlock Style="{StaticResource DbTextBlock}" Margin="3" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets}" Text="Targets (monster hunting quest)" FontStyle="Italic" />
			<f:Separator/>

			<f:Property Label="0 - Target ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets[0].Mob}" Grid.Row="0" Grid.Column="0" ToolTip="Name of monster to kill.">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Targets[0].Mob, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Targets[0].Mob, Converter={StaticResource MobPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Mobs" SourceField="{Binding Targets[0].Mob}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Amount" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets[0].Count}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Targets[0].Count, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="1 - Target ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets[1].Mob}" Grid.Row="1" Grid.Column="0" ToolTip="Name of monster to kill.">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Targets[1].Mob, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Targets[1].Mob, Converter={StaticResource MobPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Mobs" SourceField="{Binding Targets[1].Mob}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Amount" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets[1].Count}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Targets[1].Count, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="2 - Target ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets[2].Mob}" ToolTip="Name of monster to kill.">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Targets[2].Mob, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Targets[2].Mob, Converter={StaticResource MobPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Mobs" SourceField="{Binding Targets[2].Mob}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Amount" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets[2].Count}">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Targets[2].Count, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>
		</f:HorizontalGrid>

		<f:HorizontalGrid Grid.Row="2" x:Name="_gridDrops" Margin="0 10 0 0" ColumnCount="3" SeparatorWidth="0">
			<TextBlock Style="{StaticResource DbTextBlock}" Margin="3" Text="Drops (gathering quest)" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops}" FontStyle="Italic" />
			<f:Separator />
			<f:Separator />

			<f:Property Label="0 - Mob ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[0].Mob}" ToolTip="Monster to kill." >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[0].Mob, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Drops[0].Mob, Converter={StaticResource MobPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Mobs" SourceField="{Binding Drops[0].Mob}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Name ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[0].Item}" ToolTip="Item to drop." >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[0].Item, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Drops[0].Item, Converter={StaticResource ItemPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Items" SourceField="{Binding Drops[0].Item}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Rate" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[0].Rate}" ToolTip="Item drop rate. (10000 = 100%)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[0].Rate, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:RateEditButton SourceField="{Binding Drops[0].Rate}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="1 - Mob ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[1].Mob}" ToolTip="Monster to kill." >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[1].Mob, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Drops[1].Mob, Converter={StaticResource MobPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Mobs" SourceField="{Binding Drops[1].Mob}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Name ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[1].Item}" ToolTip="Item to drop." >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[1].Item, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Drops[1].Item, Converter={StaticResource ItemPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Items" SourceField="{Binding Drops[1].Item}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Rate" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[1].Rate}" ToolTip="Item drop rate. (10000 = 100%)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[1].Rate, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:RateEditButton SourceField="{Binding Drops[1].Rate}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="2 - Mob ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[2].Mob}" ToolTip="Monster to kill." >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[2].Mob, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Drops[2].Mob, Converter={StaticResource MobPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Mobs" SourceField="{Binding Drops[2].Mob}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Name ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[2].Item}" ToolTip="Item to drop." >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[2].Item, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding Drops[2].Item, Converter={StaticResource ItemPreviewConverter}}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:SelectTupleButton Source="Items" SourceField="{Binding Drops[2].Item}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Rate" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops[2].Rate}" ToolTip="Item drop rate. (10000 = 100%)" >
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Drops[2].Rate, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:RateEditButton SourceField="{Binding Drops[2].Rate}" />
				</f:Property.Extras>
			</f:Property>
		</f:HorizontalGrid>
	</Grid>
</UserControl>
