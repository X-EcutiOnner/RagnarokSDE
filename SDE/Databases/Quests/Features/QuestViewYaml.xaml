<UserControl x:Class="SDE.Databases.Quests.Features.QuestViewYaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDE.Databases.Quests.Features"
			 xmlns:f="clr-namespace:SDE.Databases.Generic.Controls"
             xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:Converters="clr-namespace:SDE.Databases.Generic.Converters"
             xmlns:Tmc="clr-namespace:SDE.Editor.Generic.DbTabs"
             xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
			 xmlns:wpfbugfix="clr-namespace:TokeiLibrary.WpfBugFix;assembly=TokeiLibrary"
             xmlns:Common="clr-namespace:SDE.Databases.Generic.Common" xmlns:styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
			 Foreground="{DynamicResource TextForeground}"
			 mc:Ignorable="d" 
			 MaxWidth="800"
			 HorizontalAlignment="Left"
             d:DesignWidth="800">
	<UserControl.Resources>
		<Converters:ItemPreviewConverter x:Key="ItemPreviewConverter"/>
		<Converters:MobPreviewConverter x:Key="MobPreviewConverter"/>
		<Converters:MobNameConverter x:Key="MobNameConverter"/>
	</UserControl.Resources>
	<Grid x:Name="_gridContainer" IsEnabled="{Binding IsModelValid}">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="auto" />
			<RowDefinition Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<f:HorizontalGrid Grid.Row="0" x:Name="_gridProperties" ColumnCount="1" Width="300" HorizontalAlignment="Left">
			<TextBlock Style="{StaticResource DbTextBlock}" Text="Quest properties" FontStyle="Italic" />
			
			<f:Property Label="Id" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Id}" ToolTip="Quest ID.">
				<f:Property.Editor>
					<f:ValidationTextBox IsReadOnly="True" Text="{Binding Id}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:EditKeyButton SourceField="{Binding Id}" />
				</f:Property.Extras>
			</f:Property>

			<f:Property Label="Title" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Title}" ToolTip="Quest title.">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
			</f:Property>

			<f:Property Label="Time limit" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding TimeLimit}" ToolTip="Amount of time before the quest expires. (Default: 0)">
				<f:Property.Editor>
					<f:ValidationTextBox Text="{Binding TimeLimit, UpdateSourceTrigger=PropertyChanged}" />
				</f:Property.Editor>
				<f:Property.Extras>
					<f:TimeEditSolveButton Width="70" Height="22" Margin="3 0 0 0" SourceField="{Binding TimeLimit}" />
				</f:Property.Extras>
			</f:Property>
		</f:HorizontalGrid>

		<Grid Grid.Row="1" Name="_gridTargets" Margin="0 10 0 0">
			<Grid.RowDefinitions>
				<RowDefinition Height="auto" />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="300" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<TextBlock Style="{StaticResource DbTextBlock}" Margin="3" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Targets}" Text="Targets (monster hunting quest)" Grid.Row="0" FontStyle="Italic" Grid.ColumnSpan="4" />
			<wpfbugfix:RangeListView MinHeight="250" x:Name="_lvTargets" Grid.Row="1" Margin="3"
									 ItemsSource="{Binding Targets, UpdateSourceTrigger=PropertyChanged}"
									 TextSearch.TextPath="DisplayMobId"
									 IsHitTestVisible="{Binding IsModelValid}"
									 ListView:ListViewExtensions.IsGridSortable="True"
									 SelectionChanged="_lvTargets_SelectionChanged"
									 FocusVisualStyle="{x:Null}">
			</wpfbugfix:RangeListView>
			<Grid Grid.Row="1" Grid.Column="1" IsEnabled="{Binding IsTargetSelected}">
				<Grid.RowDefinitions>
					<RowDefinition Height="auto" />
					<RowDefinition Height="auto" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<f:HorizontalGrid Grid.Row="0" ColumnCount="2" SeparatorWidth="5">
					<f:Property Label="Mob ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.Mob}" ToolTip="Name of monster to kill.">
						<f:Property.Editor>
							<f:ValidationTextBox Text="{Binding SelectedTarget.Mob, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding SelectedTarget.Mob, Converter={StaticResource MobPreviewConverter}}" />
						</f:Property.Editor>
						<f:Property.Extras>
							<f:SelectTupleButton Source="Mobs" SourceField="{Binding SelectedTarget.Mob}" />
						</f:Property.Extras>
					</f:Property>

					<f:Property Label="Amount" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.Count}" ToolTip="Amount of monsters to kill. Set to 0 to skip the target on import.">
						<f:Property.Editor>
							<f:ValidationTextBox Text="{Binding SelectedTarget.Count, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>

					<f:Property Label="Id" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.Id}" ToolTip="Unique target index for the quest Id. Requires a positive number.">
						<f:Property.Editor>
							<f:ValidationTextBox Text="{Binding SelectedTarget.Id, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>

					<f:Property Label="Race" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.Race}" ToolTip="Monster race target. (Default: All)">
						<f:Property.Editor>
							<ComboBox ItemsSource="{Binding Path=(Common:RaceTypeInfo.All)}" SelectedItem="{Binding SelectedTarget.Race, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>

					<f:Property Label="Size" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.Size}" ToolTip="Monster size target. (Default: All)">
						<f:Property.Editor>
							<ComboBox ItemsSource="{Binding Path=(Common:SizeTypeInfo.All)}" SelectedItem="{Binding SelectedTarget.Size, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>

					<f:Property Label="Element" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.Element}" ToolTip="Monster element target. (Default: All)">
						<f:Property.Editor>
							<ComboBox ItemsSource="{Binding Path=(Common:ElementTypeInfo.All)}" SelectedItem="{Binding SelectedTarget.Element, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>

					<f:Property Label="Min level" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.MinLevel}" ToolTip="Minimum monster level target. If not supplied but MaxLevel defined, MinLevel is 1. Set to 0 to ignore MinLevel on import. (Default: 0)">
						<f:Property.Editor>
							<f:ValidationTextBox Text="{Binding SelectedTarget.MinLevel, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>

					<f:Property Label="Max level" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.MaxLevel}" ToolTip="Maximum monster level target. Set to 0 to ignore MaxLevel on import. (Default: 0)">
						<f:Property.Editor>
							<f:ValidationTextBox Text="{Binding SelectedTarget.MaxLevel, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>

					<f:Property Label="Location" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.Location}" ToolTip="Map name where kills are counted. (Default: All)">
						<f:Property.Editor>
							<f:ValidationTextBox Text="{Binding SelectedTarget.Location, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>

					<f:Property Label="Map name" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.MapName}" ToolTip="Displayed map name in quest UI. (Default: empty string)">
						<f:Property.Editor>
							<f:ValidationTextBox Text="{Binding SelectedTarget.MapName, UpdateSourceTrigger=PropertyChanged}" />
						</f:Property.Editor>
					</f:Property>
				</f:HorizontalGrid>
				<TextBlock Style="{StaticResource DbTextBlock}" Text="Mobs allowed (if empty, all mobs allowed)" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedTarget.MapMobTargets}" Grid.Row="1" FontStyle="Italic" />

				<Rectangle x:Name="GridMeasurer" Grid.Row="2" Grid.RowSpan="5" Margin="3" />
				<wpfbugfix:RangeListView Grid.Row="2" Height="100" MaxWidth="310" HorizontalAlignment="Left" Margin="3"
					IsHitTestVisible="{Binding IsTargetSelected}"
					Width="{Binding ElementName=GridMeasurer, Path=ActualWidth}"
					Name="_lvMapMobTargets"
					ItemsSource="{Binding SelectedTarget.MapMobTargets}"
					SelectionChanged="_lvMapMobTargets_SelectionChanged"
					HorizontalContentAlignment="Stretch"
					FocusVisualStyle="{x:Null}">
					<wpfbugfix:RangeListView.ItemContainerStyle>
						<Style TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
							<Setter Property="Padding" Value="0"/>
						</Style>
					</wpfbugfix:RangeListView.ItemContainerStyle>
					<wpfbugfix:RangeListView.ItemTemplate>
						<DataTemplate>
							<Grid Margin="2 0 2 0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="5*"/>
									<ColumnDefinition Width="5*"/>
								</Grid.ColumnDefinitions>
								<CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Active}" Margin="3" />
								<TextBlock Grid.Column="1" Text="{Binding MobName, Converter={StaticResource MobNameConverter}}" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}" />

								<f:Property Grid.Column="2">
									<f:Property.Editor>
										<f:ValidationTextBox Text="{Binding MobName, UpdateSourceTrigger=PropertyChanged}" />
									</f:Property.Editor>
									<f:Property.Extras>
										<f:SelectTupleButton Source="Mobs" SourceField="{Binding MobName}" />
									</f:Property.Extras>
								</f:Property>
							</Grid>
						</DataTemplate>
					</wpfbugfix:RangeListView.ItemTemplate>
				</wpfbugfix:RangeListView>
			</Grid>
		</Grid>

		<Grid Grid.Row="2" MinHeight="200" Name="_gridDrops" Margin="0 10 0 0">
			<Grid.RowDefinitions>
				<RowDefinition Height="auto" />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="300" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<TextBlock Style="{StaticResource DbTextBlock}" Text="Drops (gathering quest)" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding Drops}" Grid.Row="0" FontStyle="Italic" Grid.ColumnSpan="4" Margin="3" />
			<wpfbugfix:RangeListView MinHeight="150" x:Name="_lvDrops" Grid.Row="1" Margin="3"
									 ItemsSource="{Binding Drops, UpdateSourceTrigger=PropertyChanged}"
									 TextSearch.TextPath="DisplayNameId"
									 ListView:ListViewExtensions.IsGridSortable="True"
									 IsHitTestVisible="{Binding IsModelValid}"
									 SelectionChanged="_lvDrops_SelectionChanged"
									 FocusVisualStyle="{x:Null}">
			</wpfbugfix:RangeListView>
			<f:HorizontalGrid Grid.Row="1" Grid.Column="1" ColumnCount="2" SeparatorWidth="5" IsEnabled="{Binding IsDropSelected}">
				<f:Property Label="Name ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedDrop.Item}" ToolTip="Monster to kill. 0 will apply to all monsters. (Default: 0)">
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding SelectedDrop.Item, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding SelectedDrop.Item, Converter={StaticResource ItemPreviewConverter}}" />
					</f:Property.Editor>
					<f:Property.Extras>
						<f:SelectTupleButton Source="Items" SourceField="{Binding SelectedDrop.Item}" />
					</f:Property.Extras>
				</f:Property>
				
				<f:Property Label="Mob ID" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedDrop.Mob}" ToolTip="Item to drop.">
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding SelectedDrop.Mob, UpdateSourceTrigger=PropertyChanged}" PreviewText="{Binding SelectedDrop.PreviewMob}" />
					</f:Property.Editor>
					<f:Property.Extras>
						<f:SelectTupleButton Source="Mobs" SourceField="{Binding SelectedDrop.Mob}" />
					</f:Property.Extras>
				</f:Property>

				<f:Property Label="Amount" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedDrop.Count}" ToolTip="Amount of items that will drop. Non-stackable items default to 1. (Default: 1)" >
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding SelectedDrop.Count, UpdateSourceTrigger=PropertyChanged}" />
					</f:Property.Editor>
				</f:Property>

				<f:Property Label="Rate" Tmc:DisplayablePropertyHelper.SearchBinding="{Binding SelectedDrop.Rate}" ToolTip="Item drop rate. (10000 = 100%)">
					<f:Property.Editor>
						<f:ValidationTextBox Text="{Binding SelectedDrop.Rate, UpdateSourceTrigger=PropertyChanged}" />
					</f:Property.Editor>
					<f:Property.Extras>
						<f:RateEditButton SourceField="{Binding SelectedDrop.Rate}" />
					</f:Property.Extras>
				</f:Property>
			</f:HorizontalGrid>
		</Grid>
	</Grid>
</UserControl>
